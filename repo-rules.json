{
  "version": 1,
  "skip_dirs": [
    ".git",
    "build",
    "dist",
    ".venv",
    "__pycache__"
  ],
  "skip_prefixes": [
    "build-",
    "cmake-build"
  ],
  "skip_globs": [],
  "encoding": [
    {
      "glob": "*.py",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.md",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.json",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.toml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yaml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".gitignore",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".gitattributes",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".editorconfig",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".githooks/pre-commit",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "templates/githooks/pre-commit",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "LICENSE",
      "bom": false,
      "eol": "lf"
    }
  ],
  "width": {
    "globs": [
      "*.py"
    ],
    "limit": 140,
    "tab_width": 4
  },
  "forbidden": [],
  "headers": {
    "globs": [],
    "first_line": "#pragma once",
    "forbid_namespace_using": true
  },
  "versions": [
    {
      "id": "repo-rules-version",
      "sources": [
        {
          "path": "pyproject.toml",
          "pattern": "version\\s*=\\s*\"(\\d+)\\.(\\d+)\\.(\\d+)\""
        },
        {
          "path": "repo_rules.py",
          "pattern": "__version__\\s*=\\s*\"(\\d+)\\.(\\d+)\\.(\\d+)\""
        }
      ]
    }
  ],
  "changelog": {
    "path": "CHANGELOG.md",
    "require": "## [Unreleased]",
    "link_definitions": true
  },
  "required_files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.ja.md",
    "README.ko.md",
    "README.md",
    "README.zh-CN.md",
    "docs/adaptation.md",
    "docs/ci-scheduling.md",
    "docs/configuration.md",
    "presets/cpp-library.json",
    "presets/cpp-windows.json",
    "presets/python-tool.json",
    "repo-rules.json",
    "repo_rules.py",
    "templates/githooks/commit-msg",
    "templates/githooks/pre-commit",
    "templates/github/workflows/hygiene.yml",
    "tests/test_repo_rules.py"
  ],
  "markdown": {
    "globs": [
      "*.md"
    ],
    "check_links": true,
    "languages": {
      "default": "README.md",
      "variants": [
        "README.zh-CN.md",
        "README.ja.md",
        "README.ko.md"
      ],
      "switch_line": true,
      "stale": "warning"
    }
  },
  "gitattributes": {
    "path": ".gitattributes",
    "required_patterns": [
      "\\* text=auto",
      "\\*\\.py\\s+text eol=lf"
    ]
  },
  "comments": {
    "english": true
  },
  "commit_message": {
    "english": true
  },
  "readme_badges": {
    "files": [
      "README.md",
      "README.zh-CN.md",
      "README.ja.md",
      "README.ko.md"
    ],
    "min": 3,
    "require": [
      "actions/workflows/",
      "img.shields.io/badge/License"
    ]
  },
  "about": {
    "description": "Mechanical repository hygiene checks for C++/Python projects: encoding, line endings, version sync, changelog, links, bilingual pairs | 可机械执行的仓库工程规范检查器（Python 3.9+）：编码/行尾、列宽、版本同步、CHANGELOG、链接与双语互链",
    "order": "en-zh"
  },
  "actions": {
    "require": {
      "actions/checkout": "v7",
      "actions/setup-python": "v7",
      "actions/setup-node": "v7",
      "actions/upload-artifact": "v7",
      "actions/download-artifact": "v8",
      "actions/cache": "v6"
    },
    "allow_sha": true
  }
}
