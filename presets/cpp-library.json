{
  "version": 1,
  "skip_dirs": [
    ".git",
    "build",
    "_deps",
    "third_party",
    "vcpkg_installed",
    "out"
  ],
  "skip_prefixes": [
    "build-",
    "build_",
    "cmake-build"
  ],
  "skip_globs": [],
  "encoding": [
    {
      "glob": "*.c",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.cc",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.cpp",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.cxx",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.h",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.hh",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.hpp",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.hxx",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.md",
      "bom": false,
      "eol": "crlf"
    },
    {
      "glob": "*.mdc",
      "bom": false,
      "eol": "crlf"
    },
    {
      "glob": "CMakeLists.txt",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.cmake",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.txt",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.json",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yaml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.py",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.ps1",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.sh",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.in",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.def",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".gitignore",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".gitattributes",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".editorconfig",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "LICENSE",
      "bom": false,
      "eol": "lf"
    }
  ],
  "width": {
    "globs": [
      "*.c",
      "*.cc",
      "*.cpp",
      "*.cxx",
      "*.h",
      "*.hh",
      "*.hpp",
      "*.hxx"
    ],
    "limit": 140,
    "tab_width": 4
  },
  "forbidden": [
    {
      "id": "cmake-libs",
      "globs": [
        "*.c",
        "*.cc",
        "*.cpp",
        "*.cxx",
        "*.h",
        "*.hh",
        "*.hpp",
        "*.hxx"
      ],
      "pattern": "#\\s*pragma\\s+comment\\s*\\(\\s*(lib|linker)",
      "message": "link Windows libraries through CMake target_link_libraries"
    }
  ],
  "headers": {
    "globs": [
      "*.h",
      "*.hh",
      "*.hpp",
      "*.hxx"
    ],
    "first_line": "#pragma once",
    "forbid_namespace_using": true
  },
  "versions": [],
  "changelog": {
    "path": "CHANGELOG.md",
    "require": "## [Unreleased]",
    "link_definitions": true
  },
  "required_files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "markdown": {
    "globs": [
      "*.md"
    ],
    "check_links": true,
    "bilingual_pairs": [
      [
        "README.md",
        "README.en.md"
      ]
    ]
  },
  "gitattributes": {
    "path": ".gitattributes",
    "required_patterns": [
      "\\* text=auto"
    ]
  }
}
